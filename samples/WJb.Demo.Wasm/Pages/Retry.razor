@page "/retry"

@inject IStore Store
@inject NavigationManager Nav

<h3 class="mb-3">Retry Action</h3>

<div class="card">
    <div class="card-body">

        <p class="text-muted mb-3">
            Demonstrates an action that fails on the first attempt
            and succeeds on the next execution.
        </p>

        <button class="btn btn-warning w-100 mb-3"
                @onclick="Start">
            <i class="bi bi-arrow-repeat me-1"></i>
            Run
        </button>

        <div class="small text-muted">
            Flow:
            retry-email →
            fail →
            retry →
            log
        </div>

    </div>
</div>

<SourceViewer Source="RetryAction.json" />

@code {
    private async Task Start()
    {
        await Store.EnqueueAsync(
            RetryEmailAction.Key,
            new RetryEmailInput
            {
                To = "test@test.com"
            },
            new JobOptions
            {
                MaxRetries = 1,
                RetryDelay = TimeSpan.FromSeconds(1)
            });

        Nav.NavigateTo("/");
    }
}