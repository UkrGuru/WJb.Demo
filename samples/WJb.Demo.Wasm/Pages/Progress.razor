@page "/progress"

@inject IStore Store
@inject NavigationManager Nav

<h3 class="mb-3">Progress Action</h3>

<div class="card">
    <div class="card-body">

        <p class="text-muted mb-3">
            Demonstrates progress reporting via ReportProgress.
        </p>

        <button class="btn btn-success w-100 mb-3"
                @onclick="Start">
            <i class="bi bi-activity me-1"></i>
            Run
        </button>

        <div class="small text-muted">
            Flow: Enqueue → Execute → ReportProgress → Complete
        </div>

    </div>
</div>

<SourceViewer Source="Progress" />

@code {
    private async Task Start()
    {
        await Store.EnqueueAsync(
            ProgressAction.Key,
            new ProgressPayload
            {
                DelayMs = 300
            });

        Nav.NavigateTo("/");
    }
}