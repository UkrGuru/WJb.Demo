@page "/configured"

@inject IStore Store
@inject NavigationManager Nav

<h3 class="mb-3">Configured Action</h3>

<div class="card">
    <div class="card-body">

        <p class="text-muted mb-3">
            Demonstrates dependency injection via settings.
        </p>

        <button class="btn btn-success w-100 mb-3" @onclick="Start">
            ⚙️ Run
        </button>

        <div class="small text-muted">
            Flow: Enqueue → Resolve Settings → Execute → Complete
        </div>

    </div>
</div>

<SourceViewer Source="Configured" />

@code
{
    private async Task Start()
    {
        await Store.EnqueueAsync(
            ConfiguredAction.Key,
            new EmailInput
            {
                To = "test@test.com"
            });

        Nav.NavigateTo("/");
    }
}