@page "/"
@inject HttpClient Http

<PageTitle>WJb Demo</PageTitle>

<div class="d-flex align-items-center gap-3 mb-2">
    <img src="_content/WJbPro.Demos/images/wjb.png" alt="WJb" width="48" />
    <h1 class="mb-0">
        WJb Demo (WASM)
    </h1>
    <a href="https://www.nuget.org/packages/WJb" target="_blank" class="btn btn-outline-primary" title="View on NuGet">
        📦
    </a>
</div>

<p class="lead">
    💡 Explore WJb through interactive examples. Learn how to build background jobs, orchestrate workflows, monitor execution, and inspect the source code behind each sample.
</p>
<WJbPro.Demos.WJbDemo.Index />

@code{

    string Json; 

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Json = await Http.GetStringAsync("/App_Data/actions.json");

        }
        catch (Exception ex)
        {
            Json = ex.Message;
            Console.WriteLine($"Error loading actions.json: {ex.Message}");
        }
    }

}
