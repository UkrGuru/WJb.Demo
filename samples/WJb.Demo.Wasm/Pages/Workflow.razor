@page "/workflow"

@inject IStore Store
@inject NavigationManager Nav

<h3 class="mb-3">Order Workflow</h3>

<div class="card">
    <div class="card-body">

        <p class="text-muted mb-3">
            Demonstrates multi-step workflow execution.
        </p>

        <button class="btn btn-primary w-100 mb-3"
                @onclick="Start">
            <i class="bi bi-diagram-3 me-1"></i>
            Run
        </button>

        <div class="small text-muted">
            Create Order →
            Reserve Stock →
            Charge Payment →
            Send Confirmation
        </div>

    </div>
</div>

<SourceViewer Source="OrderWorkflow" />

@code {
    private async Task Start()
    {
        await Store.EnqueueAsync(
            CreateOrderAction.Key,
            new OrderInput
            {
                OrderId = 1001
            });

        Nav.NavigateTo("/");
    }
}