@page "/chain"

@using WJb.Demo.Wasm.Actions

@inject IStore Store
@inject NavigationManager Nav

<h3 class="mb-3">Chained Email Action</h3>

<div class="card">
    <div class="card-body">

        <p class="text-muted mb-3">
            Demonstrates action chaining via <code>ActionResults.Next</code>.
        </p>

        <button class="btn btn-success w-100 mb-3"
                @onclick="Start">
            <i class="bi bi-link-45deg me-1"></i>
            Run
        </button>

        <div class="small text-muted">
            Flow: Enqueue → SendEmail → Next(LogAction) → Complete
        </div>

    </div>
</div>

<SourceViewer Source="ChainAction.json" />

@code {
    private async Task Start()
    {
        await Store.EnqueueAsync(
            SendEmailAction.Key,
            new EmailInput
            {
                To = "test@test.com"
            });

        Nav.NavigateTo("/");
    }
}