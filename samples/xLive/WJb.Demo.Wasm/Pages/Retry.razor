@page "/retry"

@using WJb.Demo.Wasm.Actions

@inject IJobClient Client
@inject NavigationManager Nav

<h3 class="mb-3">Retry Action</h3>

<div class="card">
    <div class="card-body">

        <p class="text-muted mb-3">
            Demonstrates an action that fails on the first attempt
            and succeeds on the next execution.
        </p>

        <button class="btn btn-warning w-100 mb-3"
                @onclick="Start">
            <i class="bi bi-arrow-repeat me-1"></i>
            Run
        </button>

        <div class="small text-muted">
            Flow:
            retry-email →
            fail →
            retry →
            log
        </div>

        <details class="mt-3">
            <summary class="text-muted">Show code</summary>

            <div class="card mt-3">
                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-12">
                            <h6 class="text-muted">Start</h6>
                            <pre class="bg-light p-2 rounded small mb-0"><code>
await Client.EnqueueAsync(
    RetryEmailAction.Key,
    new RetryEmailInput
    {
        To = "test@test.com"
    });
                            </code></pre>
                        </div>

                        <div class="col-md-6">
                            <h6 class="text-muted">Action</h6>
                            <pre class="bg-light p-2 rounded small mb-0"><code>
public sealed class RetryEmailAction
    : JobAction&lt;RetryEmailInput&gt;
{
    public const string Key = "retry-email";

    private static int _attempts;

    public override async Task&lt;ActionResult&gt; ExecuteAsync(
        RetryEmailInput input,
        CancellationToken ct)
    {
        _attempts++;

        await Task.Delay(500, ct);

        if (_attempts == 1)
            throw new InvalidOperationException(
                "SMTP temporarily unavailable.");

        _attempts = 0;

        return ActionResults.Next(
            new JobCommand(
                LogAction.Key,
                new LogInput
                {
                    Message =
                        $"Email sent to {input.To}"
                }));
    }
}
                            </code></pre>
                        </div>

                        <div class="col-md-6">
                            <h6 class="text-muted">Payload</h6>
                            <pre class="bg-light p-2 rounded small mb-3"><code>
public sealed class RetryEmailInput
{
    public string? To { get; set; }
}
                            </code></pre>

                            <h6 class="text-muted">Behavior</h6>
                            <pre class="bg-light p-2 rounded small mb-0"><code>
Execution 1:
    Exception

Execution 2:
    Success

Next:
    LogAction
                            </code></pre>
                        </div>

                    </div>

                </div>
            </div>
        </details>

    </div>
</div>

@code {
    private async Task Start()
    {

        await Client.EnqueueAsync(
            RetryEmailAction.Key,
            new RetryEmailInput
            {
                To = "test@test.com"
            },
            new JobOptions
            {
                MaxRetries = 1,
                RetryDelay = TimeSpan.FromSeconds(1)
            });


        Nav.NavigateTo("/");
    }
}