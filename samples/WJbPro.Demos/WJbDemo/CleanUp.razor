@using WJb
@using WJbPro.Demos.Actions

@inject IStore Store

<h3 class="mb-3">⏰ Clean Up Jobs</h3>

<div class="card">
    <div class="card-body">

        <p class="text-muted mb-3">
            Removes completed jobs from storage to keep the system clean and reduce database size.
        </p>

        <button class="btn btn-primary mb-3" @onclick="Run">
            ▶ Run
        </button>

        <div class="small text-muted">
            Flow: Enqueue → Cleanup → Complete
        </div>

    </div>
</div>

<SourceViewer Source="WJb.CleanUp" />

@code {
    private async Task Run()
        => await Store.EnqueueAsync(
            CleanUpAction.Key, null);
}