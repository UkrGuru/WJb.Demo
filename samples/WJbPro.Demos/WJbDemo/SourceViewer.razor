@using System.Text.Json

@if (Files.Count > 0)
{
    <details class="mt-3">
        <summary class="text-muted">
            View Source
        </summary>

        <ul class="nav nav-tabs mt-3">
            @for (var i = 0; i < Files.Count; i++)
            {
                var index = i;
                <li class="nav-item">
                    <button class="nav-link @(index == Selected ? "active" : null)" @onclick="() => Selected = index">
                        @Files[index].Name
                    </button>
                </li>
            }
        </ul>

        <div class="card border-top-0">
            <div class="card-body">
                <pre class="mb-0"><code>@Files[Selected].Content</code></pre>
            </div>
        </div>

    </details>
}

@code {

    [Parameter, EditorRequired]
    public string Source { get; set; } = default!;

    public sealed class SourceFile
    {
        public string Name { get; set; } = "";
        public string Content { get; set; } = "";
    }

    private readonly List<SourceFile> Files = [];

    private int Selected;

    protected override async Task OnInitializedAsync()
    {
        var assembly = typeof(SourceViewer).Assembly;

        var filesJson = await assembly.ReadEmbeddedResourceAsync(
            $"WJbPro.Demos.Resources.{Source}.files.json");

        var names = JsonSerializer.Deserialize<List<string>>(filesJson) ?? [];

        foreach (var name in names)
        {
            Files.Add(new SourceFile
            {
                Name = name,
                Content = await assembly.ReadEmbeddedResourceAsync(
                    $"WJbPro.Demos.Resources.{Source}.{name}")
            });
        }
    }
}