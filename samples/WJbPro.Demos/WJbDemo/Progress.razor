@using WJb
@using WJbPro.Demos.Actions

@inject IStore Store

<h3 class="mb-3">📊 Progress Tracking</h3>

<div class="card">
    <div class="card-body">

        <p class="text-muted mb-3">
            Demonstrates progress reporting via ReportProgress, job cancellation, and retry.
        </p>

        <button class="btn btn-primary mb-3" @onclick="Run">
            ▶ Run
        </button>

        <div class="small text-muted">
            Flow: Enqueue → Execute → ReportProgress → Complete
        </div>

    </div>
</div>

<SourceViewer Source="WJb.Progress" />

@code {
    private async Task Run() 
        => await Store.EnqueueAsync(
            ProgressAction.Key,
            new ProgressPayload { DelayMs = 1000 });
}