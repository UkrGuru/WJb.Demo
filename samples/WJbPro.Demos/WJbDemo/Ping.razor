@using WJb
@using WJbPro.Demos.Actions

@inject IStore Store

<h3 class="mb-3">⏰ Ping Website</h3>

<div class="card">
    <div class="card-body">

        <p class="text-muted mb-3">
            Uses CronScheduler to check website availability every minute and record the response.
        </p>

        <button class="btn btn-primary mb-3" @onclick="Run">
            ▶ Run
        </button>

        <div class="small text-muted">
            Flow: Cron Schedule → Enqueue → HTTP Ping → Complete
        </div>

    </div>
</div>

<SourceViewer Source="WJb.Ping" />

@code {
    private async Task Run()
        => await Store.EnqueueAsync(HttpPingAction.Key, null);
}