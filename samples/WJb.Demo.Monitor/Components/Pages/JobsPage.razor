@page "/jobs"

@using WJb

@inject IWJb Wjb

<div class="text-center mb-3">
    <button class="btn btn-success" @onclick="RunDemoAsync">
        ▶ Run Demo Workflow
    </button>

    <div class="small text-secondary mt-2">
        Import Customers → Generate Report → Send Email
    </div>
</div>

<JobsTab RefreshInterval="@(TimeSpan.FromSeconds(1))" />

@code {
    private Task RunDemoAsync()
        => Wjb.EnqueueAsync("import-customers", 
            new ImportCustomersInput { Source = "CRM" });
}
