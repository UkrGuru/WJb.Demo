@page "/"

<PageTitle>Home</PageTitle>

<div class="container-fluid py-4 px-md-4">

    <h1 class="h3 mb-1">
        WJb Monitor
    </h1>

    <div class="text-secondary mb-4">
        Monitor and manage WJb jobs, actions and services.
    </div>

    <div class="row g-3">

        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        ☰ Jobs
                    </h5>

                    <p class="card-text text-secondary">
                        Browse jobs, inspect payloads and retry failed executions.
                    </p>

                    <NavLink class="btn btn-outline-primary"
                             href="jobs">
                        View Jobs
                    </NavLink>

                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        ✦ Actions
                    </h5>

                    <p class="card-text text-secondary">
                        Configure action definitions and test execution.
                    </p>

                    <NavLink class="btn btn-outline-primary"
                             href="actions">
                        View Actions
                    </NavLink>

                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        ⚙ Services
                    </h5>

                    <p class="card-text text-secondary">
                        Manage service configuration and dependencies.
                    </p>

                    <NavLink class="btn btn-outline-primary"
                             href="services">
                        View Services
                    </NavLink>

                </div>
            </div>
        </div>

    </div>

</div>
