<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Actions\**" />
    <Compile Remove="SyncSdk\**" />
    <EmbeddedResource Remove="Actions\**" />
    <EmbeddedResource Remove="SyncSdk\**" />
    <None Remove="Actions\**" />
    <None Remove="SyncSdk\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="App_Data\Source\customers.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\Source\customers.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="App_Data\State\checkpoint.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="App_Data\Target\customers.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="WJb" Version="1.3.2" />
  </ItemGroup>

</Project>
