<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="BrowserStorageBenchmark.cs" />
      <Compile Remove="FakeJsRuntime.cs" />
    </ItemGroup>

    <ItemGroup>

        <!-- Benchmark -->
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />

        <!-- WJb -->
        <PackageReference Include="WJb" Version="1.3.1" />
        <PackageReference Include="WJb.IndexedDB" Version="1.3.1" />
        <PackageReference Include="WJb.SqlServer" Version="1.3.1" />
        <PackageReference Include="WJb.SQLite" Version="1.3.1" />

    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>none</DebugType>
    </PropertyGroup>

</Project>
