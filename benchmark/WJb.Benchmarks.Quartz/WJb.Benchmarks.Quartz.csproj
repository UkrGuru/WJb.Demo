<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
      <DebugType>none</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
      <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="BenchConfig.cs" />
      <Compile Remove="CoreBenchmarks.cs" />
      <Compile Remove="ExecutionBenchmarks.cs" />
      <Compile Remove="MemoryBenchmarks.cs" />
      <Compile Remove="NoOpAction.cs" />
      <Compile Remove="ParallelBenchmarks.cs" />
      <Compile Remove="ProcessMemoryBenchmarks.cs" />
      <Compile Remove="ScaleBenchmarks.cs" />
      <Compile Remove="StartupBenchmarks.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />

        <!-- WJb -->
