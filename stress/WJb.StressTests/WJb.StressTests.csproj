<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>WJb</RootNamespace>
        <AssemblyTitle>WJb.Tests</AssemblyTitle>
        <AssemblyName>WJb.Tests</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>
    <ItemGroup>
      <Compile Remove="Extensions\**" />
      <Compile Remove="FunctionalTests\**" />
      <Compile Remove="IntegrationTests\**" />
      <Compile Remove="xLive\**" />
      <EmbeddedResource Remove="Extensions\**" />
      <EmbeddedResource Remove="FunctionalTests\**" />
      <EmbeddedResource Remove="IntegrationTests\**" />
      <EmbeddedResource Remove="xLive\**" />
      <None Remove="Extensions\**" />
      <None Remove="FunctionalTests\**" />
      <None Remove="IntegrationTests\**" />
      <None Remove="xLive\**" />
    </ItemGroup>
    <ItemGroup>
      <Compile Remove="CronWorkerTests.cs" />
      <Compile Remove="InMemory\InMemoryStoreDbFixture.cs" />
      <Compile Remove="Internal\Runtime_WJbRuntimeTests.cs" />
      <Compile Remove="ProductionReadyTests.cs" />
      <Compile Remove="WJbBuilderTests.cs" />
      <Compile Remove="WJbConfigTests.cs" />
      <Compile Remove="WJbRuntimeTests.cs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.*" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.*" />
        <PackageReference Include="WJb" Version="1.1.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="xunit.v3" Version="4.0.1" />
    </ItemGroup>
</Project>
